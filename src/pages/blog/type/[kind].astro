---
import Base from '../../../layouts/Base.astro';
import Filters from '../../../components/Filters.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
  const kinds = [...new Set(posts.map((p) => p.data.kind))];
  const items = [
    { href: '/blog/', label: 'All' },
    ...kinds.map((k) => ({ href: `/blog/type/${k}/`, label: k === 'article' ? 'Articles' : 'Posts' })),
    ...tags.map((tg) => ({ href: `/blog/tag/${tg}/`, label: tg })),
  ];
  return kinds.map((kind) => ({ params: { kind }, props: { kind, items, posts: posts.filter((p) => p.data.kind === kind) } }));
}
const { kind, items, posts } = Astro.props;
const label = kind === 'article' ? 'Articles' : 'Posts';
---
<Base title={`Blog: ${label}`} description={`${label} on frontend, web standards and accessibility.`}>
  <section class="block">
    <div class="block-head"><h1>Blog: {label}</h1><a href="/rss.xml">RSS</a></div>
    <Filters label="Filter writing" items={items} current={`/blog/type/${kind}/`} />
    <PostList posts={posts} level="h2" />
  </section>
</Base>
