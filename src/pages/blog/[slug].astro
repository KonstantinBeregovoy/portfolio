---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/content';
import { en as t } from '../../i18n/en';
import { PERSON_ID, breadcrumb, abs } from '../../lib/seo';
import { externalAttrs } from '../../lib/external';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const minutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).length / 220));
// Some articles keep their title as the Markdown H1. Do not print it twice.
const titleInBody = (post.body ?? '').trimStart().startsWith('# ');
---
<Base
  title={d.title}
  description={d.description}
  type="article"
  image={d.cover}
  imageAlt={d.coverAlt}
  imageWidth={d.cover ? 1200 : undefined}
  imageHeight={d.cover ? 630 : undefined}
  date={d.date}
  jsonLd={[
    {
      '@type': 'BlogPosting',
      headline: d.title,
      description: d.description,
      datePublished: d.date.toISOString(),
      dateModified: d.date.toISOString(),
      author: { '@id': PERSON_ID },
      inLanguage: 'en',
      keywords: d.tags.join(', '),
      url: abs(`/blog/${post.id}/`),
      mainEntityOfPage: abs(`/blog/${post.id}/`),
      ...(d.cover ? { image: abs(d.cover) } : {}),
    },
    breadcrumb([
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog/' },
      { name: d.title, path: `/blog/${post.id}/` },
    ]),
  ]}
>
  <article class="article">
    <p class="meta"><a href="/blog/">Blog</a></p>
    {!titleInBody && <h1>{d.title}</h1>}
    <p class="meta">
      <a href="/about/" rel="author">{t.siteName}</a>
      <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
      <span>{minutes} min read</span>
      <span>{d.kind}</span>
      {d.tags.map((tg) => <a href={`/blog/tag/${tg}/`}>#{tg}</a>)}
    </p>
    {d.cover && <img class="article-cover" src={d.cover} alt={d.coverAlt ?? d.title} width="1200" height="630" />}
    <div class="article-body"><Content /></div>
    {d.linkedin && <p style="margin-top: 48px;"><a href={d.linkedin} {...externalAttrs(d.linkedin)}>Discuss on LinkedIn</a></p>}
  </article>
</Base>
