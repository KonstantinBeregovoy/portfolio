---
import '../styles/global.css';
import { en as t } from '../i18n/en';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  date?: Date;
}
const { title, description = t.tagline, type = 'website', image = '/img/logo.png', date } = Astro.props;
const fullTitle = title ? `${title} | ${t.siteName}` : `${t.siteName}, ${t.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const year = new Date().getFullYear();

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: t.siteName,
  jobTitle: t.role,
  url: 'https://bereg.dev/',
  image: new URL('/img/konstantin.jpg', Astro.site).toString(),
  sameAs: [t.links.linkedin, t.links.github],
};
---
<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <link rel="alternate" type="application/rss+xml" title={`${t.siteName} blog`} href="/rss.xml" />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {date && <meta property="article:published_time" content={date.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${t.siteName}, home`}>
          <img src="/img/logo-small.png" alt="" width="240" height="169" />
          <span>{t.siteName}</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {t.nav.map((item) => (
              <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <div class="wrap"><slot /></div>
    </main>
    <footer class="site">
      <div class="wrap">
        <span>© {year} {t.siteName}</span>
        <span>
          <a href={t.links.linkedin} rel="me">LinkedIn</a> ·
          <a href={t.links.github} rel="me">GitHub</a> ·
          <a href={`mailto:${t.email}`}>{t.email}</a> ·
          <a href="/rss.xml">RSS</a>
        </span>
      </div>
    </footer>
  </body>
</html>
