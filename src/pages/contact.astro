---
import Base from '../layouts/Base.astro';
import { en as t } from '../i18n/en';
---
<Base title="Contact" description="Contact Konstantin Beregovoy: email, LinkedIn and GitHub.">
  <section class="block">
    <h1>{t.contact.heading}</h1>
    <p class="lede" style="margin: 16px 0 32px;">{t.contact.text}</p>
    <ul class="plain">
      <li><strong>Email</strong><a href={`mailto:${t.email}`}>{t.email}</a></li>
      <li><strong>LinkedIn</strong><a href={t.links.linkedin} rel="me">linkedin.com/in/konstantin-beregovoy</a></li>
      <li><strong>GitHub</strong><a href={t.links.github} rel="me">github.com/KonstantinBeregovoy</a></li>
    </ul>
  </section>
</Base>
