{
  // Cloudflare Workers with static assets: serves the built Astro site from ./dist.
  // "name" must match the Worker name in the Cloudflare dashboard.
  "name": "portfolio",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./dist",
    // Unknown URLs get dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  },
  // Branch builds run `npx wrangler preview` (Workers Builds, non-production branches): a preview link for every PR.
  // The block can stay empty; assets and compatibility settings above apply to previews too.
  "previews": {}
}
