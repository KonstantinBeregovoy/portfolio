---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const all = (await getCollection('certificates')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const groups = [
  { id: 'ai', title: 'AI' },
  { id: 'learning', title: 'Professional learning' },
  { id: 'earlier', title: 'Earlier' },
] as const;
const bundled = (id: string) => all.filter((c) => c.data.bundle === id);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', timeZone: 'UTC' });
---
<Base title="Certificates" description="Certificates and courses in AI, accessibility and engineering management.">
  <section class="block">
    <h1>Certificates</h1>
    <p class="lede" style="margin: 16px 0 0;">{all.length} certificates and courses. Where a verification link exists, it opens the original record.</p>
  </section>

  {groups.map((g) => {
    const items = all.filter((c) => c.data.group === g.id && !c.data.bundle);
    return items.length > 0 && (
      <section class="block" aria-labelledby={`g-${g.id}`}>
        <div class="block-head"><h2 id={`g-${g.id}`}>{g.title}</h2></div>
        <div class="grid">
          {items.map((c) => {
            const parts = bundled(c.id);
            return (
              <article class="card">
                <span class="meta">{c.data.issuer} · {fmt(c.data.date)}</span>
                <h3>{c.data.title}</h3>
                {c.data.credentialUrl && <p><a href={c.data.credentialUrl} rel="noopener">Verify credential</a></p>}
                {parts.length > 0 && (
                  <details>
                    <summary>Included courses ({parts.length})</summary>
                    <ul>
                      {parts.map((p) => (
                        <li>{p.data.credentialUrl ? <a href={p.data.credentialUrl} rel="noopener">{p.data.title}</a> : p.data.title}</li>
                      ))}
                    </ul>
                  </details>
                )}
              </article>
            );
          })}
        </div>
      </section>
    );
  })}
</Base>
