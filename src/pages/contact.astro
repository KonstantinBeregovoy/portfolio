---
import Base from '../layouts/Base.astro';
import { en as t } from '../i18n/en';
import { externalAttrs } from '../lib/external';
const description = t.showEmail
  ? 'Contact Konstantin Beregovoy about frontend leadership and consulting: email, LinkedIn and GitHub.'
  : 'Contact Konstantin Beregovoy about frontend leadership and consulting: LinkedIn and GitHub.';
---
<Base pageType="ContactPage" title="Contact" description={description}>
  <section class="block">
    <h1>{t.contact.heading}</h1>
    <p class="lede" style="margin: 16px 0 32px;">{t.contact.text}</p>
    <ul class="plain">
      {t.showEmail && <li><strong>Email</strong><a href={`mailto:${t.email}`}>{t.email}</a></li>}
      <li><strong>LinkedIn</strong><a href={t.links.linkedin} {...externalAttrs(t.links.linkedin, 'me')}>linkedin.com/in/konstantin-beregovoy</a></li>
      <li><strong>GitHub</strong><a href={t.links.github} {...externalAttrs(t.links.github, 'me')}>github.com/KonstantinBeregovoy</a></li>
    </ul>
  </section>
</Base>
