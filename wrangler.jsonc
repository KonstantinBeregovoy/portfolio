{
  // Cloudflare Workers with static assets: serves the built Astro site from ./dist.
  // "name" must match the Worker name in the Cloudflare dashboard.
  "name": "bereg-dev",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./dist",
    // Unknown URLs get dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  }
}
