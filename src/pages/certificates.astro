---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { PERSON_ID } from '../lib/seo';
import { externalAttrs } from '../lib/external';

const all = (await getCollection('certificates')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const groups = [
  { id: 'ai', title: 'AI' },
  { id: 'learning', title: 'Professional learning' },
  { id: 'earlier', title: 'Earlier' },
] as const;
const bundled = (id: string) => all.filter((c) => c.data.bundle === id);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', timeZone: 'UTC' });
---
<Base
  pageType="CollectionPage"
  title="Certificates"
  description="Certificates and courses of Konstantin Beregovoy in AI, accessibility and engineering management, with verification links where they exist."
  jsonLd={{
    '@type': 'ItemList',
    name: 'Certificates',
    itemListElement: all.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'EducationalOccupationalCredential',
        name: item.data.title,
        credentialCategory: 'certificate',
        recognizedBy: { '@type': 'Organization', name: item.data.issuer },
        validFrom: item.data.date.toISOString().slice(0, 10),
        ...(item.data.credentialUrl ? { url: item.data.credentialUrl } : {}),
        about: { '@id': PERSON_ID },
      },
    })),
  }}
>
  <section class="block">
    <h1>Certificates</h1>
    <p class="lede" style="margin: 16px 0 0;">{all.length} certificates and courses. Where a verification link exists, it opens the original record.</p>
  </section>

  {groups.map((g) => {
    const items = all.filter((c) => c.data.group === g.id && !c.data.bundle);
    return items.length > 0 && (
      <section class="block" aria-labelledby={`g-${g.id}`}>
        <div class="block-head"><h2 id={`g-${g.id}`}>{g.title}</h2></div>
        <div class="grid">
          {items.map((c) => {
            const parts = bundled(c.id);
            return (
              <article class="card">
                <span class="meta">{c.data.issuer} · {fmt(c.data.date)}</span>
                <h3>{c.data.title}</h3>
                {c.data.credentialUrl && <p><a href={c.data.credentialUrl} {...externalAttrs(c.data.credentialUrl)}>Verify credential</a></p>}
                {parts.length > 0 && (
                  <details>
                    <summary>Included courses ({parts.length})</summary>
                    <ul>
                      {parts.map((p) => (
                        <li>{p.data.credentialUrl ? <a href={p.data.credentialUrl} {...externalAttrs(p.data.credentialUrl)}>{p.data.title}</a> : p.data.title}</li>
                      ))}
                    </ul>
                  </details>
                )}
              </article>
            );
          })}
        </div>
      </section>
    );
  })}
</Base>
