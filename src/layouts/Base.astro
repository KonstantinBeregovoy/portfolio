---
import '../styles/global.css';
import { en as t } from '../i18n/en';
import { graphLd, type JsonLd } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  date?: Date;
  noindex?: boolean;
  pageType?: string;
  jsonLd?: JsonLd | JsonLd[];
}
const {
  title,
  description = t.tagline,
  type = 'website',
  image = '/img/logo.png',
  imageAlt,
  imageWidth,
  imageHeight,
  date,
  noindex = false,
  pageType = 'WebPage',
  jsonLd,
} = Astro.props;
const fullTitle = title ? `${title} | ${t.siteName}` : `${t.siteName}, ${t.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const year = new Date().getFullYear();
const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const ld = graphLd({ pageType, title: fullTitle, description, url: canonical.toString(), extra });
const card = image === '/img/logo.png' ? 'summary' : 'summary_large_image';
const imageLabel = imageAlt ?? title ?? t.siteName;
---
<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0a1220" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Beregovoy" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <link rel="preload" href="/fonts/plex-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={t.siteName} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${t.siteName} blog`} href="/rss.xml" />
    <meta property="og:locale" content="en" />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageLabel} />
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    {date && <meta property="article:published_time" content={date.toISOString()} />}
    {date && <meta property="article:author" content={t.siteName} />}
    <meta name="twitter:card" content={card} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {card === 'summary_large_image' && <meta name="twitter:image" content={ogImage} />}
    {card === 'summary_large_image' && <meta name="twitter:image:alt" content={imageLabel} />}
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${t.siteName}, home`}>
          <img src="/img/logo-hdr.jpg" alt="" width="240" height="169" />
          <span>{t.siteName}</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {t.nav.map((item) => (
              <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <div class="wrap"><slot /></div>
    </main>
    <footer class="site">
      <div class="wrap">
        <span>© {year} {t.siteName}</span>
        <span>
          <a href={t.links.linkedin} rel="me">LinkedIn</a> ·
          <a href={t.links.github} rel="me">GitHub</a> ·
          {t.showEmail && (<><a href={`mailto:${t.email}`}>{t.email}</a> ·</>)}
          <a href="/rss.xml">RSS</a>
        </span>
        <span class="site-note">Lighthouse 100 · Security Headers A+ · <a href="/projects/bereg-dev/">How this site is built</a></span>
      </div>
    </footer>
    <div class="lamp-grid" aria-hidden="true"></div>
    <div class="lamp-glow" aria-hidden="true"></div>
    <script src="/lamp.js" defer></script>
  </body>
</html>
